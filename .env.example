# Copy this file to .env and fill in what you need. .env is git-ignored, so secrets stay local.
# Load it with "npm run local" (or "npm run dev" to auto-restart on changes); both read .env
# natively. Plain "npm start" ignores .env and reads only real environment variables, which is
# what a cloud host provides.

# --- Networking -------------------------------------------------------------
# Cloud hosts inject PORT themselves and it wins over CTP_PORT. Leave PORT unset locally.
CTP_PORT=5090
# Defaults to 127.0.0.1 locally and 0.0.0.0 when NODE_ENV=production.
CTP_HOST=127.0.0.1

# --- Storage ----------------------------------------------------------------
# The app stores its whole database as one JSON document. Choose where that lives:
#
# 1. A file on disk (the default). Fine locally, and on any host with a real disk or a
#    mounted volume. Do NOT use this on a host with an ephemeral filesystem.
# 2. Postgres. Set DATABASE_URL and the directory, logins and uploaded certificate sheets
#    are all kept in the database instead, so nothing is lost when the instance restarts.
#    Required on Render's free plan, Cloud Run, Vercel and similar.
#
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Managed Postgres certificates are not verified by default. Set PGSSLMODE=verify-full to
# enforce a full certificate check, or PGSSLMODE=disable for a local, unencrypted server.
# PGSSLMODE=verify-full

# Only used when DATABASE_URL is NOT set. Point these at a persistent disk in production,
# otherwise a redeploy wipes everything.
#   Azure App Service (Linux): /home/ctp/data and /home/ctp/uploads
#   Render (with a paid disk mounted at /var/ctp): /var/ctp/data and /var/ctp/uploads
# CTP_DATA_DIR=/home/ctp/data
# CTP_UPLOAD_DIR=/home/ctp/uploads
# CTP_BACKUP_DIR defaults to <CTP_DATA_DIR>/backups.

# --- Security ---------------------------------------------------------------
# Enables production error masking, 0.0.0.0 binding and Secure session cookies.
# NODE_ENV=production
# Force the Secure cookie flag on or off independently (1 = on, 0 = off).
# CTP_SECURE_COOKIES=1

# --- First-run administrator ------------------------------------------------
# Only used when the database is seeded for the very first time.
# The fixed default below applies ONLY outside production. When NODE_ENV=production and
# CTP_ADMIN_PASSWORD is unset, the app generates a random password and prints it to the
# startup log on first boot — always set it explicitly for a real deployment.
CTP_ADMIN_NAME=CTP National Administrator
CTP_ADMIN_EMAIL=admin@ctp.org
CTP_ADMIN_PASSWORD=Ctp@2026
