# Copy to .env only if you use a loader; the app reads plain environment variables.
# Everything here is optional — the defaults are the local development settings.

# --- Networking -------------------------------------------------------------
# Cloud hosts inject PORT themselves and it wins over CTP_PORT. Leave PORT unset locally.
CTP_PORT=5090
# Defaults to 127.0.0.1 locally and 0.0.0.0 when NODE_ENV=production.
CTP_HOST=127.0.0.1

# --- Storage ----------------------------------------------------------------
# Point these at a persistent disk in production, otherwise a redeploy wipes everything.
#   Azure App Service (Linux): /home/ctp/data and /home/ctp/uploads
#   Render (with a disk mounted at /var/ctp): /var/ctp/data and /var/ctp/uploads
# CTP_DATA_DIR=/home/ctp/data
# CTP_UPLOAD_DIR=/home/ctp/uploads
# CTP_BACKUP_DIR defaults to <CTP_DATA_DIR>/backups.

# --- Security ---------------------------------------------------------------
# Enables production error masking, 0.0.0.0 binding and Secure session cookies.
# NODE_ENV=production
# Force the Secure cookie flag on or off independently (1 = on, 0 = off).
# CTP_SECURE_COOKIES=1

# --- First-run administrator ------------------------------------------------
# Only used when the database is seeded for the very first time.
# The fixed default below applies ONLY outside production. When NODE_ENV=production and
# CTP_ADMIN_PASSWORD is unset, the app generates a random password and prints it to the
# startup log on first boot — always set it explicitly for a real deployment.
CTP_ADMIN_NAME=CTP National Administrator
CTP_ADMIN_EMAIL=admin@ctp.org
CTP_ADMIN_PASSWORD=Ctp@2026
